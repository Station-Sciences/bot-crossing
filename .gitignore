node_modules
dist

# Your colony: which repo sits on which plot, and what you archived. Holds the names and
# paths of the repos you work in, so it stays out of the repository.
data/*.json
data/*.tmp

# Per-machine Claude Code permissions — personal paths live in here.
.claude/settings.local.json

# Raw asset packs. The built glbs in public/assets are checked in instead — see the README
# under "Where the art comes from" for how to re-fetch these if you need to rebuild.
assets-src

.DS_Store
*.log

# Local capture output — not part of the project.
recordings

# Sound samples. The game synthesises every sound it needs, so nothing here is required;
# files dropped in alongside a manifest.json override the synth by name. Kept out of the
# repository because the samples people use (Splice, most stock libraries) are licensed for
# use in a work, not for redistribution on their own.
public/audio/*
!public/audio/README.md
public/dev-mobile.html

# Character design source — turnarounds, sculpts, high-res art, anything worked up for the
# crew character itself rather than for the runtime. The built result ships; the source does
# not. Same reasoning as the sound samples above: what is in the repository is MIT, and this
# is the one part of the project deliberately kept out of that grant. See TRADEMARKS.md.
design/character
