  "kind": "t100.status-overlay",
  "namespaces": {
    "canonical": {
      "instance_suffix": "appended only when two manifest items share a canonical base",
      "note": "off-die chips declare no bar, so their canonical id is <chip_set>.<chip>.<unit>",
      "rule": "<chip_set>.<chip>.<bar_or_block>.<unit>",
      "source": "t100.yaml"
    },
    "join_rule": "join a replay event on attrs.logical_unit_ref, which names a canonical component key directly. Where an event carries only a runtime attrs.component_path, resolve it through alias_index, which maps an observed runtime id to every canonical id deriving it; a multi-instance unit resolves to more than one.",
    "runtime_event": {
      "note": "aliases only; the runtime does not emit the canonical bar segment, so no alias is marked canonical",
      "rule": "<chip_set>.<chip>.<unit_or_instance>",
      "source": "component constructor ids in the model trees"
    }
  },
